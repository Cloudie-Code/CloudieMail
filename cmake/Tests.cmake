if(BUILD_TESTING)
  add_executable(cloudiemail-protocol-tests tests/mail_protocol_tests.cpp)
  target_link_libraries(cloudiemail-protocol-tests PRIVATE cloudiemail_core)
  add_test(NAME mail-protocols COMMAND cloudiemail-protocol-tests)
  add_executable(cloudiemail-smtp-probe tests/smtp_transport_probe.cpp)
  target_link_libraries(cloudiemail-smtp-probe PRIVATE cloudiemail_core)
  add_executable(cloudiemail-mail-tests tests/mail_features_tests.cpp)
  target_link_libraries(cloudiemail-mail-tests PRIVATE cloudiemail_core)
  add_test(NAME mail-features COMMAND cloudiemail-mail-tests)
  add_executable(cloudiemail-config-tests tests/config_tests.cpp)
  target_link_libraries(cloudiemail-config-tests PRIVATE cloudiemail_core)
  add_test(NAME config COMMAND cloudiemail-config-tests)
  add_executable(cloudiemail-tests tests/core_tests.cpp)
  target_link_libraries(cloudiemail-tests PRIVATE cloudiemail_core)
  add_test(NAME core COMMAND cloudiemail-tests)
  add_executable(cloudiemail-setup-tests tests/setup_tests.cpp)
  target_link_libraries(cloudiemail-setup-tests PRIVATE cloudiemail_core)
  add_executable(cloudiemail-process-probe tests/process_probe.cpp)
  if(WIN32)
    add_executable(cloudiemail-windows-gui-snapshot tests/windows_gui_snapshot.cpp)
    target_link_libraries(cloudiemail-windows-gui-snapshot PRIVATE cloudiemail_core shell32 comctl32 comdlg32 uxtheme)
    add_executable(cloudiemail-http-tests tests/windows_http_tests.cpp)
    target_link_libraries(cloudiemail-http-tests PRIVATE cloudiemail_core)
    add_test(NAME windows-http-adapter COMMAND cloudiemail-http-tests)
    add_executable(cloudiemail-acl-tests tests/windows_acl_tests.cpp)
    target_link_libraries(cloudiemail-acl-tests PRIVATE cloudiemail_core)
    add_test(NAME windows-acl COMMAND cloudiemail-acl-tests)
  endif()
  if(CLOUDIEMAIL_GUI AND NOT WIN32)
    add_executable(cloudiemail-gtk-setup-tests tests/gui_gtk_setup.cpp)
    target_link_libraries(cloudiemail-gtk-setup-tests PRIVATE cloudiemail_core PkgConfig::GTK4)
  endif()
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_link_options(cloudiemail-process-probe PRIVATE -static)
  endif()
  find_package(Python3 COMPONENTS Interpreter)
  if(Python3_Interpreter_FOUND)
    add_test(NAME imap-integration COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/imap_integration.py $<TARGET_FILE:cloudiemail>)
    set_tests_properties(imap-integration PROPERTIES TIMEOUT 180)
    add_test(NAME integration COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/integration.py $<TARGET_FILE:cloudiemail>)
    set_tests_properties(integration PROPERTIES TIMEOUT 120)
    if(NOT CMAKE_CROSSCOMPILING)
      add_test(NAME integration-apache-backend COMMAND ${CMAKE_COMMAND} -E env CLOUDIEMAIL_TEST_APACHE=1 ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/integration.py $<TARGET_FILE:cloudiemail>)
      add_test(NAME smtp-transport COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/smtp_transport_test.py $<TARGET_FILE:cloudiemail-smtp-probe>)
      set_tests_properties(smtp-transport PROPERTIES TIMEOUT 60)
      add_test(NAME onboarding COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/setup_integration.py $<TARGET_FILE:cloudiemail-setup-tests>)
      set_tests_properties(onboarding PROPERTIES TIMEOUT 60)
    endif()
  endif()
endif()
